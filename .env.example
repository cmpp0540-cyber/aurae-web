# ─────────────────────────────────────────────────────────────
# Aurae — Shopify Storefront API
# ─────────────────────────────────────────────────────────────
# Your myshopify domain (NOT the custom domain) or the custom domain
# if it is already serving the storefront.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=auraevital.com

# Storefront API access token (public token, safe for the browser,
# but we only ever use it server-side here).
# Shopify admin → Settings → Apps and sales channels → Develop apps
#   → your app → Configuration → Storefront API → enable
#   unauthenticated_read_product_listings + unauthenticated_write_checkouts
#   → API credentials → Storefront API access token
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version
SHOPIFY_API_VERSION=2025-07

# Subscribe & Save discount shown on product cards (0.10 = 10% off)
NEXT_PUBLIC_SUBSCRIBE_DISCOUNT=0.10

# ─────────────────────────────────────────────────────────────
# Klaviyo — newsletter signup (server-side only)
# ─────────────────────────────────────────────────────────────
# PRIVATE key. Never prefix it with NEXT_PUBLIC_ — that would ship it to the
# browser. Klaviyo → Settings → API keys → Create private key, with scopes:
#   lists:write · profiles:write · subscriptions:write
KLAVIYO_PRIVATE_API_KEY=

# The list subscribers are added to.
# Klaviyo → Audience → Lists & Segments → your list → Settings → List ID
KLAVIYO_LIST_ID=
